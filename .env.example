# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — real secrets must NEVER be committed.

# --- Auth.js (session encryption) ---
# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET=

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=

# --- Gmail push notifications (Day 3 — leave empty until then) ---
# Pub/Sub topic, e.g. projects/<your-project-id>/topics/gmail-push
GMAIL_PUBSUB_TOPIC=
# Random string; the webhook rejects requests without it
PUBSUB_VERIFICATION_TOKEN=

# --- Pusher Channels (Day 3 — leave empty until then, https://pusher.com) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
