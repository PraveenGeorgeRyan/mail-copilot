# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — real secrets must NEVER be committed.

# --- Auth.js (session encryption) ---
# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET=

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=

# --- Optional ---
# Disable CopilotKit anonymous telemetry
COPILOTKIT_TELEMETRY_DISABLED=true
# Required only in production/hosted environments (e.g. Vercel)
# AUTH_TRUST_HOST=true
